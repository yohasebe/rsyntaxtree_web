<div class="container" style="padding: 0;">
  <div class="row">
    <div class="col-lg-6">
      <div id="result" >
        <a href="<%= $SUB_DIRECTORY %>/img/sample.png" data-lightbox="sample">
          <img style="max-width:100%; max-height:100%; " alt="RSyntaxTree Sample" src="<%= $SUB_DIRECTORY %>/img/sample.png" />
        </a>
      </div>
      <div class="text-right" style="margin-top:10px; margin-bottom:10px; line-height: 100%;">
        <small>
          Left-click to focus; right-click to save image<br />
          Image-area and text-area are vertically resizable
        </small>
      </div>
    </div>

    <div class="col-lg-6">
      <div id="status" style="min-height:1.5em; padding-left: 1em; margin-top: 5px; background-color: #484848	;">
        <span id="alert">
          <span class="text text-info">●</span> <span class="alertmessage"></span>
        </span>
      </div>
      <div class="anchor" id="rst-editor"></div>

      <div id="editor"><%= $SAMPLE1 %></div>

      <div class="text-right" style="margin-top:10px; margin-bottom:10px; line-height: 100%;">
        <small>
          In version 1.0, the tree drawing syntax has changed significantly. <br />
          Please see the
          <a href="https://yohasebe.github.io/rsyntaxtree/documentation">documentation</a> and
          <a target="_blank" rel="noopener noreferrer"
                             href="https://yohasebe.github.io/rsyntaxtree/examples">examples</a>.
        </small>
      </div>

      <div  class="text-right">
        <div class="row" style="margin-top:12px; margin-bottom:12px;">
          <div class="col-sm-12">
            <div style="display:inline">
              <input type="checkbox" value="" id="auto-bracket">
              <label for="auto-bracket">
                Auto-close brackets
              </label>&nbsp;&nbsp;
            </div>
            <button type="button" class="btn btn-sm btn-light" id="check"><i class="far fa-check-square"></i> Check brackets</button>&nbsp;
            <button type="button" class="btn btn-sm btn-light" id="clear"><i class="fas fa-eraser"></i> Clear text</button>&nbsp;
            <button type="button" class="btn btn-sm btn-info" id="toggle-ipa-keyboard" title="Click to show/hide IPA symbols for phonetic transcription"><i class="fas fa-keyboard"></i> IPA</button>
          </div>
        </div>

        <div id="ipa-keyboard-panel" style="display:none; margin-bottom:15px;">
          <div class="card">
            <div class="card-body">
              <ul class="nav nav-tabs" id="ipa-tabs" role="tablist">
                <li class="nav-item">
                  <a class="nav-link active" id="markup-tab" data-toggle="tab" href="#markup" role="tab">Markup</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" id="vowels-tab" data-toggle="tab" href="#vowels" role="tab">Vowels</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" id="consonants-tab" data-toggle="tab" href="#consonants" role="tab">Consonants</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" id="diacritics-tab" data-toggle="tab" href="#diacritics" role="tab">Diacritics</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" id="suprasegmentals-tab" data-toggle="tab" href="#suprasegmentals" role="tab">Suprasegmentals</a>
                </li>
              </ul>
              <div class="tab-content" id="ipa-tab-content" style="padding-top: 10px;">
                <div class="tab-pane fade show active" id="markup" role="tabpanel">
                  <button type="button" class="btn btn-sm btn-outline-secondary ipa-char-btn" data-char="\\" title="Backslash (escape / newline)">\</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary ipa-char-btn" data-char="|" title="Bar (boxed text)">|</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary ipa-char-btn" data-char="*" title="Italic / Bold">*</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary ipa-char-btn" data-char="_" title="Subscript / Superscript">_</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary ipa-char-btn" data-char="^" title="Triangle connector">^</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary ipa-char-btn" data-char="#" title="Brackets / Rectangle">#</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary ipa-char-btn" data-char="{" title="Circle (open)">{</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary ipa-char-btn" data-char="}" title="Circle (close)">}</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary ipa-char-btn" data-char="<>" title="Whitespace">&lt;&gt;</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary ipa-char-btn" data-char="@" title="Per-node color">@</button>
                </div>
                <div class="tab-pane fade" id="vowels" role="tabpanel"></div>
                <div class="tab-pane fade" id="consonants" role="tabpanel"></div>
                <div class="tab-pane fade" id="diacritics" role="tabpanel"></div>
                <div class="tab-pane fade" id="suprasegmentals" role="tabpanel"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="row" style="margin-top:12px; margin-bottom:12px;">
          <div class="col-sm-4">
            <button class="btn btn-sm btn-primary draw btn-block" id="draw_png" type="button"><i class="fas fa-image"></i> Draw <b>PNG</b></button>
          </div>
          <div class="col-sm-4">
            <button class="btn btn-sm btn-primary draw btn-block" id="draw_svg" type="button"><i class="fas fa-vector-square"></i> Draw <b>SVG</b></button>
          </div>
          <div class="col-sm-4">
            <button class="btn btn-sm btn-secondary draw btn-block" id="download_pdf" type="button"><i class="fas fa-file-pdf"></i> Download <b>PDF</b></button>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<div class="container" style="margin-top: 28px; padding: 0;">
  <div class="row">
    <div class="col-md-4">
      <div class="option-grid">
            <label for="tidy" title="Layout scale from the most spacious to the most dense. Symmetric: fully balanced. Low: packed, strict word order. Medium: packed further; words never swap order. High: densest; word order kept per row only"><i class="fas fa-compress opt-icon"></i>Tidy layout</label>
            <select class="form-control form-control-sm" name="tidy" id="tidy">
              <option value="symmetric">Symmetric</option>
              <option value="off" selected="selected">Off</option>
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
            </select>
            <label for="hspacing" title="Scales every horizontal gap, in all layout modes — the horizontal counterpart of vertical spacing (1.0 = default)"><i class="fas fa-arrows-left-right opt-icon"></i>H spacing</label>
            <select class="form-control form-control-sm" name="hspacing" id="hspacing">
              <option value="0.5">0.5</option>
              <option value="0.75">0.75</option>
              <option value="1.0" selected="selected">1.0</option>
              <option value="1.5">1.5</option>
              <option value="2.0">2.0</option>
              <option value="3.0">3.0</option>
            </select>
            <label for="vheight" title="Vertical distance between tree levels (connector height). In tidy modes this sets the base height, to which a small automatic extra is added to even out branch angles"><i class="fas fa-arrows-up-down opt-icon"></i>V spacing</label>
            <select class="form-control form-control-sm" name="vheight" id="vheight">
              <option value="0.5">0.5</option>
              <option value="1.0">1.0</option>
              <option value="1.5">1.5</option>
              <option value="2.0" selected="selected">2.0</option>
              <option value="3.0">3.0</option>
              <option value="4.0">4.0</option>
              <option value="5.0">5.0</option>
            </select>
            <label for="direction"><i class="fas fa-sitemap opt-icon"></i>Direction</label>
            <select class="form-control form-control-sm" name="direction" id="direction">
              <option value="ttb" selected="selected">Top to Bottom</option>
              <option value="ltr">Left to Right</option>
            </select>
        <label for="mirror" title="Flip the tree horizontally so it expands right to left (convention for RTL scripts such as Arabic and Hebrew)"><i class="fas fa-right-left opt-icon"></i>Mirror (RTL)</label>
        <div class="btn-group btn-group-sm btn-group-toggle" data-toggle="buttons">
          <label class="btn btn-light">
            <input type="radio" name="mirror" id="mirror-on" value="on" autocomplete="off"> On
          </label>
          <label class="btn btn-light active">
            <input type="radio" name="mirror" id="mirror-off" value="off" autocomplete="off" checked> Off
          </label>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="option-grid">
            <label for="fontstyle"><i class="fas fa-font opt-icon"></i>Font</label>
            <select class="form-control form-control-sm" name="fontstyle" id="fontstyle">
              <option value="noto-serif">Noto Serif</option>
              <option value="noto-sans">Noto Sans</option>
              <option value="noto-sans-mono">Noto Sans Mono</option>
            </select>
            <label for="fontsize"><i class="fas fa-text-height opt-icon"></i>Size</label>
            <select class="form-control form-control-sm" name="fontsize" id="fontsize">
              <option value="6">6</option>
              <option value="8">8</option>
              <option value="10">10</option>
              <option value="12">12</option>
              <option value="14">14</option>
              <option value="16" selected="selected">16</option>
              <option value="18">18</option>
              <option value="20">20</option>
              <option value="22">22</option>
              <option value="24">24</option>
              <option value="26">26</option>
            </select>
            <label for="color"><i class="fas fa-palette opt-icon"></i>Color</label>
            <select class="form-control form-control-sm" name="color" id="color">
              <option value="modern">Modern</option>
              <option value="traditional" selected="selected">Traditional</option>
              <option value="none">None</option>
            </select>
        <label for="transparent"><i class="fas fa-chess-board opt-icon"></i>Transparent bg</label>
        <div class="btn-group btn-group-sm btn-group-toggle" data-toggle="buttons">
          <label class="btn btn-light">
            <input type="radio" name="transparent" id="transparent-on" value="on" autocomplete="off"> On
          </label>
          <label class="btn btn-light active">
            <input type="radio" name="transparent" id="transparent-off" value="off" autocomplete="off" checked> Off
          </label>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="option-grid">
            <label for="leafstyle"><i class="fas fa-code-branch opt-icon"></i>Connector shape</label>
            <select class="form-control form-control-sm" name="leafstyle" id="leafstyle">
              <option value="auto" selected="selected">Auto</option>
              <option value="bar">Bar</option>
              <option value="nothing">None</option>
            </select>
            <label for="linewidth"><i class="fas fa-grip-lines opt-icon"></i>Line width</label>
            <select class="form-control form-control-sm" name="linewidth" id="linewidth">
              <option value="1" selected="selected">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
            </select>
        <label for="polyline"><i class="fas fa-wave-square opt-icon"></i>Polyline</label>
        <div class="btn-group btn-group-sm btn-group-toggle" data-toggle="buttons">
          <label class="btn btn-light">
            <input type="radio" name="polyline" id="polyline-on" value="on" autocomplete="off"> On
          </label>
          <label class="btn btn-light active">
            <input type="radio" name="polyline" id="polyline-off" value="off" autocomplete="off" checked> Off
          </label>
        </div>
        <label for="hide_default_connectors"><i class="fas fa-eye-slash opt-icon"></i>Hide connectors</label>
        <div class="btn-group btn-group-sm btn-group-toggle" data-toggle="buttons">
          <label class="btn btn-light">
            <input type="radio" name="hide_default_connectors" id="hide_default_connectors-on" value="on" autocomplete="off"> On
          </label>
          <label class="btn btn-light active">
            <input type="radio" name="hide_default_connectors" id="hide_default_connectors-off" value="off" autocomplete="off" checked> Off
          </label>
        </div>
        <span></span>
        <button type="button" class="btn btn-sm btn-link text-muted pl-0" id="reset-settings" title="Clear the display settings saved in this browser and restore the defaults">Reset settings</button>
      </div>
    </div>
  </div>
</div>
